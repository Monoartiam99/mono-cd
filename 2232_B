#include <bits/stdc++.h>
using namespace std;

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while(t--){
        int n;
        cin >> n;
        vector<long long> a(n);
        for(auto &x : a) cin >> x;
        
        long long best = LLONG_MAX;
        long long sum = 0;
        
        for(int i = 0; i < n; i++){
            sum += a[i];
            best = min(best, sum / (i + 1));
            cout << best << " \n"[i == n-1];
        }
    }
}